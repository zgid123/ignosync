{
  "name": "ignosync",
  "version": "0.0.2",
  "description": "Create .gitignore for specific TechStacks",
  "author": "Alpha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgid123/ignosync.git"
  },
  "keywords": [
    "git",
    "gitignore",
    "cli",
    "tool"
  ],
  "license": "MIT",
  "bin": {
    "ignosync": "./lib/cli.cjs"
  },
  "files": [
    "lib"
  ],
  "directories": {
    "lib": "lib"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clear": "pnpm -r exec rimraf node_modules dist .turbo lib && pnpm rimraf node_modules .turbo",
    "test": "vitest run --coverage",
    "update-packages": "pnpm update -i -r --latest",
    "build": "tsdown",
    "release": "pnpm build && changeset version && NPM_CONFIG_FORCE=true changeset publish",
    "set-release": "changeset",
    "local:run": "GIT_IGNORE_DEV=true tsx src/cli.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@alphacifer/biome": "^0.0.11",
    "@alphacifer/tsconfig": "^0.0.15",
    "@biomejs/biome": "2.4.15",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@types/node": "25.9.0",
    "@types/prompts": "2.4.9",
    "@vitest/coverage-istanbul": "4.1.6",
    "changeset": "0.2.6",
    "lefthook": "2.1.6",
    "msw": "2.14.6",
    "rimraf": "6.1.3",
    "tsdown": "0.22.0",
    "tsx": "4.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "dependencies": {
    "axios": "1.16.1",
    "commander": "14.0.3",
    "prompts": "2.4.2",
    "tslib": "2.8.1"
  }
}
